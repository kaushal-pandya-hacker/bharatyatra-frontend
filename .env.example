# BHARATYATRA FRONTEND — PRODUCTION VERCEL ENVIRONMENT VARIABLES
# Configure these variables in the Vercel Dashboard -> Settings -> Environment Variables

# NestJS Backend API Endpoint URL
NEXT_PUBLIC_API_URL=https://api.bharatyatra.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.bharatyatra.com/api/v1

# Site Base URL
NEXT_PUBLIC_SITE_URL=https://bharatyatra.com

# Map & Location Services Configuration
NEXT_PUBLIC_MAP_PROVIDER=maptiler
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here
NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=your_maptiler_api_key_here

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
