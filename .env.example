# ==============================================================================
# BHARATYATRA FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# SANITIZED FOR TECHNICAL ARCHITECTURE AUDIT — ZERO REAL CREDENTIALS
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=https://www.bharatyatra.in/api
NEXT_PUBLIC_API_BASE_URL=https://api.bharatyatra.in/api/v1

# Site Metadata & Production Domain
NEXT_PUBLIC_SITE_URL=https://www.bharatyatra.in

# Map & GIS Provider Configuration
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_KEY=YOUR_MAPTILER_KEY_HERE
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE
NEXT_PUBLIC_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Supabase Auth & Cloud Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=contributions

# Optional Alternative Cloud Storage: Cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Optional Alternative Cloud Storage: AWS S3 / Cloudflare R2
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1

# WebPush Notifications (VAPID RFC 8292)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:security@bharatyatra.in
