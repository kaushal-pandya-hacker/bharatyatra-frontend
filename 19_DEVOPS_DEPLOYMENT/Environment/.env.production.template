# CHALO FARVA — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT ACTUAL SECRET VALUES TO GIT. USE PLACEHOLDERS ONLY.

NODE_ENV=production
PORT=4000

# PostgreSQL Connection String (Private Network / VPC)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require&schema=public"

# Redis Cache & BullMQ Cluster Connection
REDIS_URL="redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379"

# AI Microservice HTTP Endpoint & Gemini API Credentials
AI_SERVICE_URL="http://ai-service-prod:8000"
GEMINI_API_KEY="<GEMINI_API_KEY_PLACEHOLDER>"

# Auth Secrets & CORS Origins
JWT_SECRET="<SECURE_256BIT_JWT_SECRET_PLACEHOLDER>"
CORS_ORIGIN="https://www.chalofarva.com,https://app.chalofarva.com"

# Payment Gateway Live Credentials (Razorpay / UPI)
RAZORPAY_KEY_ID="<RAZORPAY_LIVE_KEY_ID_PLACEHOLDER>"
RAZORPAY_KEY_SECRET="<RAZORPAY_LIVE_KEY_SECRET_PLACEHOLDER>"
RAZORPAY_WEBHOOK_SECRET="<RAZORPAY_WEBHOOK_SECRET_PLACEHOLDER>"

# Travel Provider API Keys
GSRTC_API_KEY="<GSRTC_PROD_API_KEY_PLACEHOLDER>"
HOTEL_SUPPLIER_API_KEY="<HOTEL_PROD_API_KEY_PLACEHOLDER>"
WEATHER_API_KEY="<WEATHER_API_KEY_PLACEHOLDER>"

# Multi-Channel Notification Provider Credentials
SENDGRID_API_KEY="<SENDGRID_PROD_API_KEY_PLACEHOLDER>"
