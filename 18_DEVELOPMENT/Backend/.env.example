# ==============================================================================
# BHARATYATRA NESTJS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# SANITIZED FOR TECHNICAL ARCHITECTURE AUDIT — ZERO REAL CREDENTIALS
# ==============================================================================

# Core Application Settings
PORT=4000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=https://www.bharatyatra.in,https://admin.bharatyatra.in
FRONTEND_URL=https://www.bharatyatra.in
STORAGE_BASE_URL=https://storage.bharatyatra.in

# Database & Cache Persistence
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5433/bharatyatra_db?schema=public
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6380

# Security & Authentication
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=30d
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_PORTAL_SECRET_KEY
ADMIN_BOOTSTRAP_USERNAME=admin@bharatyatra.in
ADMIN_BOOTSTRAP_PASSWORD=YOUR_BOOTSTRAP_PASSWORD_HERE

# Third-Party Travel Aggregators (Hotelbeds / HBX)
HBX_API_KEY=YOUR_HBX_API_KEY
HBX_API_SECRET=YOUR_HBX_API_SECRET
HBX_BASE_URL=https://api.test.hotelbeds.com/hotel-api/1.0

# Transport Providers (Buses & Trains)
ROUTING_ENABLED=true
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=http://localhost:5000
ROUTING_TIMEOUT_MS=5000
BUS_PROVIDER=mock
BUS_API_KEY=YOUR_BUS_API_KEY
TRAIN_PROVIDER=mock
TRAIN_PROVIDER_API_KEY=YOUR_TRAIN_API_KEY

# FinTech & Payment Rails (BharatGateway / Razorpay)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
ENABLE_LIVE_PAYMENTS=false
PAYMENT_UPI_ID=bharatyatra@upi

# WebPush Notifications (VAPID RFC 8292)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:security@bharatyatra.in

# AI & LLM Inference
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

