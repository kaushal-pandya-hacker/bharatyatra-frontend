# CHALO FARVA — BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.example)

# Application Server
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://chalofarva.com

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://chalo_user:chalo_password@localhost:5432/chalo_farva_db?schema=public

# Security & Secrets (Must be rotated in production)
JWT_SECRET=chalo_farva_production_jwt_secret_key_minimum_32chars_required
JWT_EXPIRES_IN=7d

# Redis Infrastructure
REDIS_URL=redis://localhost:6379

# Live Routing & Geographic Intelligence (OSRM / OpenStreetMap)
ROUTING_ENABLED=true
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=http://router.project-osrm.org
ROUTING_TIMEOUT_MS=5000

# Transactional Email & Messaging Providers
EMAIL_PROVIDER=sandbox
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.chalofarva.com
SMTP_PASS=placeholder_smtp_password

# External Gateway Credentials (Optional)
GEMINI_API_KEY=placeholder_gemini_key
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
