  quoteReference     String    @unique @db.VarChar(50)
  packageId          String    @db.Uuid
  userId             String?   @db.Uuid
  travelDate         DateTime  @db.Date
  adultsCount        Int       @default(1)
  childrenCount      Int       @default(0)
  roomsCount         Int       @default(1)
  hotelCategory      String?   @db.VarChar(50)
  transportOption    String?   @db.VarChar(50)
  selectedActivities String[]  @default([])
  supplierCostInr    Decimal   @db.Decimal(12, 2)
  taxInr             Decimal   @db.Decimal(12, 2)
  platformFeeInr     Decimal   @db.Decimal(12, 2)
  markupInr          Decimal   @db.Decimal(12, 2)
  discountInr        Decimal   @db.Decimal(12, 2)
  totalAmountInr     Decimal   @db.Decimal(12, 2)
  currency           String    @default("INR") @db.VarChar(10)
