// Chalo Farva — Prisma Database Schema v1.0
// Description: Master database schema mapping 54+ tables across 22 modules.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRoleType {
  CUSTOMER
  SUPPLIER
  ADMIN
  SUPPORT
  OPERATIONS
  FINANCE
  CONTENT_MANAGER
}

enum GujaratRegion {
  Kutch
  Saurashtra
  South_Gujarat
  Central_Gujarat
  North_Gujarat
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  PENDING
  REJECTED
}

enum TripLifecycleStatus {
  DRAFT
  PLANNING
  READY
  BOOKED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TripPlanningStatus {
  AI_DRAFT
  USER_MODIFIED
  FINALIZED
}

enum ItemTypeEnum {
  ATTRACTION
  HOTEL_STAY
  BUS_TRANSIT
  RESTAURANT
  ACTIVITY
}

enum BookingLifecycleStatus {
  DRAFT
  QUOTE_CREATED
  AVAILABILITY_CHECKED
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  PAYMENT_SUCCESS
  SUPPLIER_BOOKING_PENDING
  PARTIALLY_CONFIRMED
  CONFIRMED
  CANCELLATION_REQUESTED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  FAILED
  EXPIRED
  SEARCHED
  SELECTED
  PAYMENT_CONFIRMED
  BOOKING_PENDING
  PENDING
  IN_PROGRESS
  REJECTED
  COMPLETED
  CANCEL_REQUESTED
}


enum PaymentLifecycleStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  APPROVED
  FAILED
  COMPLETED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  ON_HOLD
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ==========================================
// 1. AUTH & USERS MODULE
// ==========================================

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique @db.VarChar(255)
  passwordHash     String            @db.VarChar(255)
  fullName         String            @db.VarChar(255)
  phoneNumber      String?           @db.VarChar(20)
  role             UserRoleType      @default(CUSTOMER)
  status           UserAccountStatus @default(ACTIVE)
  isEmailVerified  Boolean           @default(false)
  isPhoneVerified  Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @updatedAt @db.Timestamptz

  profile          UserProfile?
  travelProfile    UserTravelProfile?
  travelers        Traveler[]
  savedDestinations SavedDestination[]
  preferences      UserPreference?
  sessions         UserSession[]
  trips            Trip[]
  bookings         Booking[]
  auditLogs        AuditLog[]
  reviews          Review[]
  supplier         Supplier?
  tripMembers      TripMember[]
  paidExpenses     TripExpense[]
  expenseSplits    ExpenseSplit[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  cancellationRequests CancellationRequest[]
  quotes           PackageQuote[]
  notifications        Notification[]

  notificationPreference NotificationPreference?
  communicationEvents  CommunicationEvent[]
  pushSubscriptions    PushSubscription[]
  nexiConversations    NexiConversation[]

  @@map("users")
}

model Supplier {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  businessName       String             @db.VarChar(255)
  legalName          String?            @db.VarChar(255)
  businessType       String             @default("HOTEL") @db.VarChar(100)
  description        String?            @db.Text
  email              String             @db.VarChar(255)
  phone              String             @db.VarChar(50)
  website            String?            @db.VarChar(255)
  address            String?            @db.VarChar(255)
  city               String?            @db.VarChar(100)
  state              String?            @default("Gujarat") @db.VarChar(100)
  country            String?            @default("India") @db.VarChar(100)
  latitude           Float?
  longitude          Float?
  logo               String?            @db.Text
  status             SupplierStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels             Hotel[]
  restaurants        Restaurant[]
  activities         Activity[]
  bookings           Booking[]

  @@index([userId])
  @@index([status])
  @@index([verificationStatus])
  @@map("suppliers")
}

model UserPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  preferredLanguage   String   @default("gu") @db.VarChar(10)
  dietaryPreference   String?  @db.VarChar(50)
  budgetTier          String   @default("BALANCED") @db.VarChar(20)
  travelPace          String   @default("MODERATE") @db.VarChar(20)
  interests           String[] @default([])
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique @db.Text
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model UserProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  firstName         String?   @db.VarChar(100)
  lastName          String?   @db.VarChar(100)
  displayName       String?   @db.VarChar(150)
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  dateOfBirth       DateTime? @db.Date
  gender            String?   @db.VarChar(20)
  profilePhoto      String?   @db.Text
  preferredLanguage String    @default("en") @db.VarChar(10)
  preferredCurrency String    @default("INR") @db.VarChar(10)
  homeCity          String?   @db.VarChar(100)
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserTravelProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  fullName           String   @db.VarChar(255)
  homeCity           String   @db.VarChar(100)
  homeState          String   @db.VarChar(100)
  homeCountry        String   @default("India") @db.VarChar(100)
  originLatitude     Float?
  originLongitude    Float?
  travelStyle        String?  @db.VarChar(50)
  budgetPreference   String?  @db.VarChar(50)
  travelPace         String?  @db.VarChar(50)
  preferredTransport String[] @default([])
  preferredLanguage  String   @default("en") @db.VarChar(10)
  interests          String[] @default([])
  typicalTravelers   Int      @default(2)
  profileCompleted   Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_travel_profiles")
}

model Traveler {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  firstName      String    @db.VarChar(100)
  lastName       String    @db.VarChar(100)
  dateOfBirth    DateTime? @db.Date
  gender         String?   @db.VarChar(20)
  nationality    String    @default("IN") @db.VarChar(10)
  documentType   String?   @db.VarChar(50)
  documentNumber String?   @db.VarChar(100)
  isSelf         Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("travelers")
}

model SavedDestination {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  destinationId String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@index([destinationId])
  @@map("saved_destinations")
}

// ==========================================
// 2. DESTINATIONS & TOURISM MODULE
// ==========================================

enum StateType {
  STATE
  UNION_TERRITORY
}

model State {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @unique @db.VarChar(100)
  slug             String        @unique @db.VarChar(100)
  code             String?       @db.VarChar(10)
  type             StateType     @default(STATE)
  capital          String?       @db.VarChar(100)
  description      String?       @db.Text
  shortDescription String?       @db.Text
  latitude         Float?
  longitude        Float?
  coverImage       String?       @db.Text
  isActive         Boolean       @default(true)
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  districts        District[]
  cities           City[]
  destinations     Destination[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
  @@map("states")
}

model District {
  id          String        @id @default(uuid()) @db.Uuid
  stateId     String        @db.Uuid
  name        String        @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  description String?       @db.Text
  latitude    Float?
  longitude   Float?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  state        State         @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities       City[]
  destinations Destination[]

  @@index([stateId])
  @@index([slug])
  @@map("districts")
}

model City {
  id          String        @id @default(uuid()) @db.Uuid
  stateId     String        @db.Uuid
  districtId  String?       @db.Uuid
  name        String        @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  description String?       @db.Text
  latitude    Float?
  longitude   Float?
  coverImage  String?       @db.Text
  isPopular   Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  state        State         @relation(fields: [stateId], references: [id], onDelete: Cascade)
  district     District?     @relation(fields: [districtId], references: [id], onDelete: SetNull)
  destinations Destination[]

  @@index([stateId])
  @@index([districtId])
  @@index([slug])
  @@map("cities")
}

model Destination {
  id                  String             @id @default(uuid()) @db.Uuid
  stateId             String?            @db.Uuid
  districtId          String?            @db.Uuid
  cityId              String?            @db.Uuid
  name                String             @db.VarChar(255)
  slug                String             @unique @db.VarChar(255)
  region              String             @default("Saurashtra") @db.VarChar(100)
  state               String             @default("Gujarat") @db.VarChar(100)
  country             String             @default("India") @db.VarChar(100)
  category            String             @db.VarChar(100)
  subCategory         String?            @db.VarChar(100)
  description         String             @db.Text
  shortDescription    String?            @db.Text
  tagline             String?            @db.VarChar(255)
  overview            String?            @db.Text
  primaryImageUrl     String             @db.Text
  heroImageUrl        String?            @db.Text
  images              String[]           @default([])
  heroColor           String?            @default("from-amber-600 to-amber-900") @db.VarChar(100)
  rating              Decimal            @default(4.5) @db.Decimal(3, 2)
  totalReviews        Int                @default(0)
  recommendedDays     Int                @default(3)
  estimatedBudget     Decimal            @default(15000.00) @db.Decimal(10, 2)
  entryFee            Decimal?           @default(0.00) @db.Decimal(10, 2)
  currency            String?            @default("INR") @db.VarChar(10)
  openingTime         String?            @db.VarChar(50)
  closingTime         String?            @db.VarChar(50)
  latitude            Float?
  longitude           Float?
  bestTimeToVisit     String?            @db.VarChar(255)
  nearestAirport      String?            @db.VarChar(255)
  nearestRailway      String?            @db.VarChar(255)
  isUNESCO            Boolean            @default(false)
  isHeritage          Boolean            @default(false)
  isReligious         Boolean            @default(false)
  isWildlife          Boolean            @default(false)
  isNature            Boolean            @default(false)
  isAdventure         Boolean            @default(false)
  isBeach             Boolean            @default(false)
  isFamilyFriendly    Boolean            @default(true)
  accessibility       String?            @default("HIGH") @db.VarChar(50)
  permitRequired      Boolean            @default(false)
  permitType          String?            @db.VarChar(100)
  accessRestriction   String?            @db.Text
  seasonalClosure     String?            @db.VarChar(255)
  specialInstructions String?            @db.Text
  popularityScore     Float?             @default(0.0)
  isFeatured          Boolean            @default(false)
  aliases             String[]           @default([])
  status              String             @default("ACTIVE") @db.VarChar(50)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now()) @db.Timestamptz
  updatedAt           DateTime           @updatedAt @db.Timestamptz

  stateRel            State?             @relation(fields: [stateId], references: [id], onDelete: SetNull)
  districtRel         District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  cityRel             City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  gallery             DestinationImage[]
  attractions         Attraction[]
  hotels              Hotel[]
  activities          Activity[]
  restaurants         Restaurant[]
  packages            Package[]
  savedByUsers        SavedDestination[]

  @@index([slug])
  @@index([region])
  @@index([state])
  @@index([stateId])
  @@index([districtId])
  @@index([cityId])
  @@index([category])
  @@index([isActive])
  @@map("destinations")
}

model DestinationImage {
  id            String      @id @default(uuid()) @db.Uuid
  destinationId String      @db.Uuid
  imageUrl      String      @db.Text
  thumbnailUrl  String?     @db.Text
  altText       String?     @db.VarChar(255)
  credit        String?     @db.VarChar(255)
  source        String?     @db.VarChar(255)
  isPrimary     Boolean     @default(false)
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("destination_images")
}

model Attraction {
  id                   String      @id @default(uuid()) @db.Uuid
  destinationId       String      @db.Uuid
  name                 String      @db.VarChar(255)
  slug                 String?     @db.VarChar(255)
  description          String?     @db.Text
  category             String      @db.VarChar(100)
  openingHours         String?     @db.VarChar(255)
  openingTime          String?     @db.VarChar(255)
  closingTime          String?     @db.VarChar(255)
  entryFeeInr          Decimal     @default(0.00) @db.Decimal(10, 2)
  averageVisitDuration Int?        @default(120)
  bestTimeToVisit      String?     @db.VarChar(255)
  latitude             Float?
  longitude            Float?
  image                String?     @db.Text
  isVerified           Boolean     @default(true)
  createdAt            DateTime    @default(now()) @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @db.Timestamptz
  destination          Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([category])
  @@map("attractions")
}

model Hotel {
  id             String      @id @default(uuid()) @db.Uuid
  destinationId  String      @db.Uuid
  supplierId     String?     @db.Uuid
  name           String      @db.VarChar(255)
  slug           String?     @db.VarChar(255)
  description    String?     @db.Text
  address        String?     @db.VarChar(255)
  latitude       Float?
  longitude      Float?
  category       String      @default("Resort") @db.VarChar(100)
  starRating     Int         @default(3)
  pricePerNight  Decimal     @db.Decimal(10, 2)
  currency       String      @default("INR") @db.VarChar(10)
  image          String?     @db.Text
  amenities      String[]    @default([])
  isVerified     Boolean     @default(false)
  status         String      @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  supplier       Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([supplierId])
  @@index([category])
  @@index([pricePerNight])
  @@index([starRating])
  @@index([status])
  @@map("hotels")
}

model BusRoute {
  id              String   @id @default(uuid()) @db.Uuid
  operatorName    String   @db.VarChar(255)
  origin          String   @db.VarChar(100)
  destination     String   @db.VarChar(100)
  departureTime   String   @db.VarChar(50)
  fareInr         Decimal  @db.Decimal(10, 2)

  @@map("bus_routes")
}

model Activity {
  id               String      @id @default(uuid()) @db.Uuid
  destinationId   String      @db.Uuid
  supplierId       String?     @db.Uuid
  title            String      @db.VarChar(255)
  slug             String?     @db.VarChar(255)
  description      String?     @db.Text
  category         String      @default("General") @db.VarChar(100)
  priceInr         Decimal     @db.Decimal(10, 2)
  durationMinutes  Int         @default(60)
  bestTimeToVisit  String?     @db.VarChar(255)
  latitude         Float?
  longitude        Float?
  image            String?     @db.Text
  isVerified       Boolean     @default(true)
  status           String      @default("ACTIVE") @db.VarChar(50)
  createdAt        DateTime    @default(now()) @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @db.Timestamptz
  destination      Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  supplier         Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([supplierId])
  @@index([category])
  @@index([status])
  @@map("activities")
}

model Restaurant {
  id             String      @id @default(uuid()) @db.Uuid
  destinationId  String      @db.Uuid
  supplierId     String?     @db.Uuid
  name           String      @db.VarChar(255)
  slug           String?     @db.VarChar(255)
  description    String?     @db.Text
  address        String?     @db.VarChar(255)
  latitude       Float?
  longitude      Float?
  cuisineType    String      @default("Gujarati Kathiyawadi") @db.VarChar(100)
  priceRange     String      @default("MODERATE") @db.VarChar(50)
  averageCost    Decimal     @default(500.00) @db.Decimal(10, 2)
  currency       String      @default("INR") @db.VarChar(10)
  openingTime    String?     @db.VarChar(50)
  closingTime    String?     @db.VarChar(50)
  image          String?     @db.Text
  rating         Decimal     @default(4.5) @db.Decimal(3, 2)
  isVerified     Boolean     @default(false)
  status         String      @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  supplier       Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([supplierId])
  @@index([cuisineType])
  @@index([priceRange])
  @@index([rating])
  @@index([status])
  @@map("restaurants")
}

// ==========================================
// 3. TRIPS & IMMUTABLE ITINERARIES
// ==========================================

model Trip {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  title              String              @db.VarChar(255)
  startDate          DateTime            @db.Date
  endDate            DateTime            @db.Date
  status             TripLifecycleStatus @default(PLANNING)
  totalBudgetInr     Decimal             @db.Decimal(12, 2)
  originCity         String?             @db.VarChar(100)
  originState        String?             @db.VarChar(100)
  originCountry      String?             @default("India") @db.VarChar(100)
  originLatitude     Float?
  originLongitude    Float?
  destinationCity    String?             @db.VarChar(100)
  destinationState   String?             @db.VarChar(100)
  destinationCountry String?             @default("India") @db.VarChar(100)
  destinationLatitude Float?
  destinationLongitude Float?
  durationDays       Int                 @default(1)
  travelers          Int                 @default(2)
  travelStyle        String?             @db.VarChar(50)
  budgetPreference   String?             @db.VarChar(50)
  travelPace         String?             @db.VarChar(50)
  preferredTransport String[]            @default([])
  interests          String[]            @default([])
  tripContextJson    Json?
  routeJson          Json?
  itineraryJson      Json?
  savedAt            DateTime?           @db.Timestamptz
  completedAt        DateTime?           @db.Timestamptz
  createdAt          DateTime            @default(now()) @db.Timestamptz
  updatedAt          DateTime            @updatedAt @db.Timestamptz

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraries        Itinerary[]
  bookings           Booking[]
  members            TripMember[]
  expenses           TripExpense[]
  expenseSettlements GroupExpenseSettlement[]

  @@map("trips")
}

model Itinerary {
  id              String             @id @default(uuid()) @db.Uuid
  tripId          String             @db.Uuid
  versionNumber   Int                @default(1)
  status          TripPlanningStatus @default(AI_DRAFT)
  changeReason    String?            @db.Text
  createdAt       DateTime           @default(now()) @db.Timestamptz

  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days            ItineraryDay[]

  @@map("itineraries")
}

model ItineraryDay {
  id           String          @id @default(uuid()) @db.Uuid
  itineraryId  String          @db.Uuid
  dayNumber    Int
  title        String          @db.VarChar(255)
  itinerary    Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  items        ItineraryItem[]

  @@map("itinerary_days")
}

model ItineraryItem {
  id             String       @id @default(uuid()) @db.Uuid
  itineraryDayId String       @db.Uuid
  itemType       ItemTypeEnum
  title          String       @db.VarChar(255)
  slotTime       String       @db.VarChar(50)
  estimatedCost  Decimal      @db.Decimal(10, 2)
  provenance     String       @default("VERIFIED_DATA") @db.VarChar(50)
  day            ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

