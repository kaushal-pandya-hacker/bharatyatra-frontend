  departureTime      DateTime            @db.Timestamptz
  arrivalTime        DateTime            @db.Timestamptz
  durationMinutes    Int                 @default(0)
  fareClass          String              @default("ECONOMY") @db.VarChar(50)
  seatNumbers        String[]            @default([])
  boardingPoint      String?             @db.Text
  droppingPoint      String?             @db.Text
  cancellationPolicy String?             @db.Text
  cancellationAmount Decimal?            @db.Decimal(12, 2)
  confirmationMode   String              @default("DIRECT") @db.VarChar(50)
  rawSupplierData    String?             @db.Text
  createdAt          DateTime            @default(now()) @db.Timestamptz
  updatedAt          DateTime            @updatedAt @db.Timestamptz

  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  segments           TransportSegment[]
  passengers         TransportPassenger[]

  @@index([bookingId])
  @@index([pnr])
  @@index([supplierReference])
  @@index([transportType, providerId])
  @@map("transport_booking_details")
}

model TransportSegment {
  id                     String                 @id @default(uuid()) @db.Uuid
  transportBookingId     String                 @db.Uuid
  segmentOrder           Int                    @default(1)
  carrierCode            String                 @db.VarChar(50)
  carrierName            String                 @db.VarChar(255)
  flightOrTrainNumber    String                 @db.VarChar(50)
  originCode             String                 @db.VarChar(50)
  originName             String                 @db.VarChar(255)
  destinationCode        String                 @db.VarChar(50)
  destinationName        String                 @db.VarChar(255)
  departureTime          DateTime               @db.Timestamptz
  arrivalTime            DateTime               @db.Timestamptz
  durationMinutes        Int                    @default(0)
  cabinClass             String?                @db.VarChar(50)
  baggageAllowance       String?                @db.VarChar(100)
  aircraftOrBusType      String?                @db.VarChar(100)
  createdAt              DateTime               @default(now()) @db.Timestamptz

  transportBooking       TransportBookingDetail @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)

  @@index([transportBookingId])
  @@map("transport_segments")
}

model TransportPassenger {
  id                     String                 @id @default(uuid()) @db.Uuid
  transportBookingId     String                 @db.Uuid
  passengerType          String                 @default("ADULT") @db.VarChar(20)
  title                  String?                @db.VarChar(20)
  firstName              String                 @db.VarChar(100)
  lastName               String                 @db.VarChar(100)
  gender                 String?                @db.VarChar(20)
  dateOfBirth            DateTime?              @db.Date
  nationality            String?                @default("IN") @db.VarChar(10)
  seatNumber             String?                @db.VarChar(20)
  idDocumentNumberMasked String?                @db.VarChar(50)
  createdAt              DateTime               @default(now()) @db.Timestamptz

  transportBooking       TransportBookingDetail @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)

  @@index([transportBookingId])
  @@map("transport_passengers")
}

model TransportSearch {
  id              String   @id @default(uuid()) @db.Uuid
  transportType   String   @db.VarChar(20)
  origin          String   @db.VarChar(100)
  destination     String   @db.VarChar(100)
  departureDate   DateTime @db.Date
  returnDate      DateTime? @db.Date
  passengersCount Int      @default(1)
  cabinClass      String?  @db.VarChar(50)
  resultCount     Int      @default(0)
  rawRequest      String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([transportType, origin, destination])
  @@map("transport_searches")
}

// ==========================================
// UNIFIED CART & UNIVERSAL CHECKOUT MODULE
// ==========================================

enum CartStatus {
  ACTIVE
  CHECKOUT
  PAYMENT_PENDING
  PROCESSING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum CartItemType {
  PACKAGE
  FLIGHT
  HOTEL
  BUS
  TRAIN
  ACTIVITY
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  PARTIALLY_CONFIRMED
  CONFIRMED
  PARTIALLY_CANCELLED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

model Cart {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String?           @db.Uuid
  sessionId        String?           @db.VarChar(255)
  status           CartStatus        @default(ACTIVE)
  currency         String            @default("INR") @db.VarChar(10)
  expiresAt        DateTime          @db.Timestamptz
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @updatedAt @db.Timestamptz

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id            String       @id @default(uuid()) @db.Uuid
  cartId        String       @db.Uuid
  itemType      CartItemType
  referenceId   String       @db.VarChar(255)
  provider      String       @db.VarChar(100)
  productName   String       @db.VarChar(255)
  metadata      Json
  priceSnapshot Decimal      @db.Decimal(12, 2)
  currency      String       @default("INR") @db.VarChar(10)
  status        String       @default("AVAILABLE") @db.VarChar(50)
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  cart          Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([itemType])
  @@map("cart_items")
}

model CheckoutSession {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String?    @db.Uuid
  cartId             String     @db.Uuid
  priceSnapshot      Json
  revalidationStatus Json?
  paymentStatus      String     @default("PENDING") @db.VarChar(50)
  bookingStatus      String     @default("PENDING") @db.VarChar(50)
  expiresAt          DateTime   @db.Timestamptz
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz

  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart               Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@index([cartId])
  @@index([userId])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

model Order {
  id                String             @id @default(uuid()) @db.Uuid
  orderReference    String             @unique @db.VarChar(50)
  userId            String?            @db.Uuid
  checkoutSessionId String?            @db.Uuid
  paymentId         String?            @db.Uuid
  currency          String             @default("INR") @db.VarChar(10)
  subtotal          Decimal            @default(0.00) @db.Decimal(12, 2)
  taxes             Decimal            @default(0.00) @db.Decimal(12, 2)
  serviceFee        Decimal            @default(0.00) @db.Decimal(12, 2)
  discount          Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmountInr    Decimal            @db.Decimal(12, 2)
  status            OrderStatus        @default(PENDING)
  createdAt         DateTime           @default(now()) @db.Timestamptz
  updatedAt         DateTime           @updatedAt @db.Timestamptz

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutSession   CheckoutSession?   @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  allocations       PaymentAllocation[]
  cancellationRequests CancellationRequest[]
  refunds           Refund[]

  @@index([userId])
  @@index([orderReference])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                 String             @id @default(uuid()) @db.Uuid
  orderId            String             @db.Uuid
  bookingId          String?            @db.Uuid
  itemType           CartItemType
  referenceId        String             @default("") @db.VarChar(255)
  provider           String             @db.VarChar(100)
  productName        String             @db.VarChar(255)
  metadata           Json
  amountInr          Decimal            @db.Decimal(12, 2)
  status             OrderStatus        @default(PENDING)
  cancellationPolicy Json?
  refundStatus       RefundStatus?
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  booking            Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  allocations        PaymentAllocation[]
  cancellationRequests CancellationRequest[]
  refunds            Refund[]

  @@index([orderId])
  @@index([bookingId])
  @@map("order_items")
}

model PaymentAllocation {
  id            String    @id @default(uuid()) @db.Uuid
  paymentId     String?   @db.Uuid
  orderId       String    @db.Uuid
  orderItemId   String?   @db.Uuid
  itemType      String    @db.VarChar(50)
  itemReference String    @db.VarChar(255)
  amountInr     Decimal   @db.Decimal(12, 2)
  status        String    @default("ALLOCATED") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @db.Timestamptz

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@map("payment_allocations")
}

// ==========================================
// CANCELLATION REQUESTS MODULE
// ==========================================

enum CancellationRequestStatus {
  REQUESTED
  ELIGIBILITY_CHECKING
  ELIGIBLE
  NOT_ELIGIBLE
  QUOTE_READY
  USER_CONFIRMATION_REQUIRED
  PROCESSING
  PARTIALLY_CANCELLED
  CANCELLED
  FAILED
  MANUAL_REVIEW
}

model CancellationRequest {
  id                 String                    @id @default(uuid()) @db.Uuid
  orderId            String                    @db.Uuid
  orderItemId        String?                   @db.Uuid
  bookingId          String?                   @db.Uuid
  userId             String                    @db.Uuid
  status             CancellationRequestStatus @default(REQUESTED)
  reason             String                    @db.Text
  eligibilityData    Json?
  quoteData          Json?
  requestedAt        DateTime                  @default(now()) @db.Timestamptz
  processedAt        DateTime?                 @db.Timestamptz
  createdAt          DateTime                  @default(now()) @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @db.Timestamptz

  user               User                      @relation(fields: [userId], references: [id])
  order              Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem          OrderItem?                @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  booking            Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  refunds            Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("cancellation_requests")
}

// ==========================================
// NOTIFICATION & COMMUNICATION SYSTEM MODULE
// ==========================================

model CommunicationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @db.VarChar(255)
  eventType   String   @db.VarChar(100)
  aggregateId String   @db.VarChar(255)
  userId      String?  @db.Uuid
  payload     Json
  status      String   @default("PROCESSED") @db.VarChar(50)
  createdAt   DateTime @default(now()) @db.Timestamptz

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([aggregateId])
  @@index([userId])
  @@map("communication_events")
}

model Notification {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  type        String                 @db.VarChar(100)
  category    String                 @default("BOOKING") @db.VarChar(50)
  title       String                 @db.VarChar(255)
  message     String                 @db.Text
  data        Json?
  deepLink    String?                @db.VarChar(500)
  readAt      DateTime?              @db.Timestamptz
  createdAt   DateTime               @default(now()) @db.Timestamptz
  updatedAt   DateTime               @updatedAt @db.Timestamptz

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@index([userId])
  @@index([category])
  @@index([readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String       @id @default(uuid()) @db.Uuid
  notificationId    String       @db.Uuid
  channel           String       @db.VarChar(50)
  provider          String       @db.VarChar(50)
  status            String       @default("PENDING") @db.VarChar(50)
  providerMessageId String?      @db.VarChar(255)
  attempts          Int          @default(0)
  lastError         String?      @db.Text
  sentAt            DateTime?    @db.Timestamptz
  deliveredAt       DateTime?    @db.Timestamptz
  failedAt          DateTime?    @db.Timestamptz
  createdAt         DateTime     @default(now()) @db.Timestamptz

  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  emailBookingUpdates    Boolean  @default(true)
  emailMarketing         Boolean  @default(false)
  whatsappBookingUpdates Boolean  @default(true)
  whatsappMarketing      Boolean  @default(false)
  inAppBookingUpdates    Boolean  @default(true)
  tripReminders          Boolean  @default(true)
  bookingUpdates         Boolean  @default(true)
  tripUpdates            Boolean  @default(true)
  aiUpdates              Boolean  @default(true)
  marketing              Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz
  updatedAt              DateTime @updatedAt @db.Timestamptz

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  endpoint   String    @unique @db.Text
  p256dh     String    @db.Text
  auth       String    @db.Text
  userAgent  String?   @db.Text
  deviceType String?   @default("desktop") @db.VarChar(50)
  browser    String?   @default("Chrome") @db.VarChar(100)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

