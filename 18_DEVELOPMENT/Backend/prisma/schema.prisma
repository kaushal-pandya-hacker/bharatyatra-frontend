  quoteVersion       Int       @default(1)
  expiresAt          DateTime  @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  package            Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user               User?     @relation(fields: [userId], references: [id])

  @@index([quoteReference])
  @@index([packageId])
  @@index([userId])
  @@map("package_quotes")
}

model SupplierBookingRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  bookingId             String   @db.Uuid
  supplierName          String   @db.VarChar(100)
  supplierBookingId     String?  @db.VarChar(255)
  serviceType           String   @db.VarChar(50)
  requestId             String   @db.VarChar(255)
  status                String   @default("PENDING") @db.VarChar(50)
  amountInr             Decimal  @db.Decimal(12, 2)
  currency              String   @default("INR") @db.VarChar(10)
  cancellationPolicy    String?  @db.Text
