# CHALO FARVA — FRONTEND PRODUCTION ENVIRONMENT TEMPLATE (.env.example)

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Site Metadata & Domain
NEXT_PUBLIC_SITE_URL=https://chalofarva.com

# Leaflet Map Tile Provider (OpenStreetMap default)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
